SOURCE_MODE=official_disclosures
SAFE_MODE=true
STORE_RAW_PDFS=false
PDF_RETENTION_DAYS=7
RAW_PDF_DIR=./data/raw-pdfs
DOWNLOAD_TIMEOUT_MS=30000
MAX_FILINGS_PER_RUN=50
SENATE_CAPITOL_TRADES_FALLBACK=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Deprecated legacy source settings. Used only with SOURCE_MODE=capitol_trades.
CAPITOL_TRADES_URL=https://www.capitoltrades.com/trades
DATABASE_PATH=./data/capitoltrades.sqlite
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
TRADING_ENABLED=false
ALLOW_LIVE_TRADING=false
PAPER_ORDER_QTY=1
MAX_TRADE_AGE_DAYS=31
BASE_POSITION_PCT=0.01
MAX_POSITION_PER_TICKER_PCT=0.03
MAX_TOTAL_EXPOSURE_PCT=0.30
MIN_SHARE_PRICE=5
BROKER_MIN_ORDER_VALUE=1
TAKE_PROFIT_PCT=0.30
STOP_LOSS_PCT=0.12
MAX_HOLDING_DAYS=45
MAX_RUNUP_PCT=0.10
SKIP_IF_PRICE_HISTORY_MISSING=true
POLITICIAN_SCORES_PATH=./data/politician_scores.json
DEBUG_SAVE_HTML=false
PLAYWRIGHT_FALLBACK=true
SCRAPER_TIMEOUT_MS=45000
MIN_TRADE_SIZE=0
